---
import '../styles/global.css';
import '../styles/qa-fixes.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FALDEO — Soluciones tecnológicas para operaciones reales',
  description = 'Software, automatización, datos e inteligencia artificial alrededor de operaciones reales, con criterio, trazabilidad y control.'
} = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202629" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
