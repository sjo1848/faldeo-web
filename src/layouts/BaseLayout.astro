---
import '../styles/global.css';
import '../styles/qa-fixes.css';
import '../styles/learn.css';
import '../styles/motion-r2.css';
import '../styles/commercial-authority.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FALDEO — Operaciones complejas. Tecnología con criterio.',
  description = 'Software, datos y automatización para mejorar coordinación, trazabilidad y decisiones en operaciones reales.'
} = Astro.props;

const canonicalUrl = siteConfig.siteUrl
  ? new URL(Astro.url.pathname, siteConfig.siteUrl).toString()
  : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202629" />
    <meta name="robots" content={siteConfig.robots} />

    <meta property="og:site_name" content="FALDEO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>