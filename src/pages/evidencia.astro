---
import BaseLayout from '../layouts/BaseLayout.astro';

const records = [
  {
    id: 'hms',
    number: '01',
    eyebrow: 'OPERACIÓN HOTELERA',
    title: 'Sistema hotelero con recorridos operativos y evidencia de ingeniería pública',
    status: 'PÚBLICO · REPOSITORIO + CASO DE INGENIERÍA',
    proves: [
      'Reservas, disponibilidad, recepción, habitaciones, housekeeping, cargos, pagos y checkout modelados como recorridos operativos.',
      'Walkthrough y capturas del producto con datos sintéticos.',
      'Arquitectura, contrato OpenAPI, pruebas de integración, browser E2E y gates de CI documentados públicamente.'
    ],
    doesNotProve: 'No demuestra adopción de clientes, impacto comercial, ROI ni operación productiva de terceros.',
    links: [
      ['Caso de ingeniería', 'https://github.com/sjo1848/hotel-management-system/blob/main/docs/ENGINEERING_CASE_STUDY.md'],
      ['Repositorio público', 'https://github.com/sjo1848/hotel-management-system'],
      ['Walkthrough y capturas', 'https://github.com/sjo1848/hotel-management-system/blob/main/docs/screenshots/README.md']
    ]
  },
  {
    id: 'agent-core',
    number: '02',
    eyebrow: 'AGENTES + SISTEMAS',
    title: 'Agente conectado a un sistema operativo bajo aprobación, política e idempotencia',
    status: 'PÚBLICO · STAGING CONTROLADO',
    proves: [
      'Disponibilidad y cotización consultadas mediante una conexión real entre Agent Core y HMS.',
      'Creación y cancelación de reservas supervisadas mediante aprobación humana vinculada a la operación exacta.',
      'Replays, conflictos, restauración de inventario, auditoría e idempotencia comprobados en staging con datos sintéticos.'
    ],
    doesNotProve: 'No demuestra producción, datos reales de clientes, pagos reales ni autonomía abierta sobre acciones de negocio.',
    links: [
      ['Cierre de evidencia ACP 2.5', 'https://github.com/sjo1848/ai-commerce-platform/blob/main/.orchestration/evidence/ACP-2.5-CLOSURE.md'],
      ['Repositorio público', 'https://github.com/sjo1848/ai-commerce-platform'],
      ['Invariantes de seguridad y control', 'https://github.com/sjo1848/ai-commerce-platform/blob/main/.orchestration/INVARIANTS.md']
    ]
  },
  {
    id: 'tenant-control',
    number: '03',
    eyebrow: 'ARQUITECTURA OPERATIVA',
    title: 'Separación de contexto, autoridad y ejecución entre organizaciones',
    status: 'PÚBLICO · INVARIANTES + CÓDIGO',
    proves: [
      'La identidad de organización proviene de contexto confiable del servidor y no del mensaje del usuario o del modelo.',
      'Las herramientas visibles se limitan por organización y la política se evalúa antes de ejecutar acciones.',
      'Intentos permitidos, denegados, aprobaciones, fallos y replays quedan dentro del contrato de auditoría.'
    ],
    doesNotProve: 'No equivale a una certificación de seguridad, auditoría externa ni garantía general contra vulnerabilidades.',
    links: [
      ['Registro de invariantes', 'https://github.com/sjo1848/ai-commerce-platform/blob/main/.orchestration/INVARIANTS.md'],
      ['Código de Agent Core', 'https://github.com/sjo1848/ai-commerce-platform/tree/main/src'],
      ['Evidencia de staging', 'https://github.com/sjo1848/ai-commerce-platform/tree/main/.orchestration/evidence']
    ]
  }
];
---
<BaseLayout
  title="Evidencia técnica — FALDEO"
  description="Artefactos públicos que permiten inspeccionar qué capacidades técnicas de FALDEO fueron implementadas o verificadas y cuáles siguen fuera de alcance."
>
  <header class="site-header" aria-label="Cabecera principal">
    <div class="shell header-inner">
      <a class="brand" href="/" aria-label="FALDEO, inicio">
        <img src="/brand/faldeo-lockup-horizontal-dark.svg" alt="FALDEO" width="176" height="64" />
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/#enfoque">Cómo trabajamos</a>
        <a href="/#evidencia">Resumen</a>
      </nav>
      <a class="button button-small desktop-cta" href="/#inicio-trabajo">Cómo empezamos</a>
      <details class="mobile-nav" data-mobile-nav>
        <summary>Menú</summary>
        <nav aria-label="Navegación móvil">
          <a href="/">Inicio</a>
          <a href="/#enfoque">Cómo trabajamos</a>
          <a href="/#evidencia">Resumen</a>
          <a href="/#inicio-trabajo">Cómo empezamos</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="contenido">
    <section class="evidence-page-hero dark-section">
      <div class="shell evidence-page-hero-grid">
        <div>
          <p class="eyebrow">EVIDENCIA TÉCNICA INSPECCIONABLE</p>
          <h1>Qué podemos mostrar.<br /><span>Y qué todavía no.</span></h1>
        </div>
        <div class="evidence-page-intro">
          <p>Esta página conecta los claims técnicos de FALDEO con artefactos públicos concretos: repositorios, casos de ingeniería, invariantes y registros de validación.</p>
          <p>No convierte pruebas técnicas en clientes, producción o resultados comerciales. Cada registro separa explícitamente lo que la evidencia permite concluir de lo que no.</p>
        </div>
      </div>
    </section>

    <section class="evidence-ledger light-section" aria-labelledby="ledger-title">
      <div class="shell">
        <div class="evidence-ledger-heading">
          <p class="eyebrow eyebrow-dark">REGISTRO PÚBLICO</p>
          <h2 id="ledger-title">Evidencia por capacidad.</h2>
        </div>

        <div class="evidence-records">
          {records.map((record) => (
            <article class="evidence-record" id={record.id}>
              <div class="evidence-record-index">{record.number}</div>
              <div class="evidence-record-main">
                <p class="evidence-label">{record.eyebrow}</p>
                <h3>{record.title}</h3>
                <span class="status-tag">{record.status}</span>
              </div>
              <div class="evidence-record-body">
                <div>
                  <small>QUÉ PERMITE CONCLUIR</small>
                  <ul>
                    {record.proves.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                <div class="evidence-nonclaim">
                  <small>QUÉ NO DEMUESTRA</small>
                  <p>{record.doesNotProve}</p>
                </div>
                <div class="evidence-artifacts">
                  <small>ARTEFACTOS PÚBLICOS</small>
                  <div>
                    {record.links.map(([label, href]) => (
                      <a href={href} target="_blank" rel="noopener noreferrer">
                        {label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-method dark-section" aria-labelledby="method-title">
      <div class="shell evidence-method-grid">
        <div>
          <p class="eyebrow">DISCIPLINA DE CLAIMS</p>
          <h2 id="method-title">La evidencia tiene límites.</h2>
        </div>
        <div>
          <p>Un repositorio público puede demostrar implementación, arquitectura, pruebas y decisiones técnicas. No demuestra por sí mismo valor de negocio, adopción, confiabilidad productiva o conocimiento profundo de un sector.</p>
          <p>Cuando exista evidencia de esas capas, FALDEO la incorporará como evidencia distinta, sin mezclarla con la prueba técnica.</p>
          <a class="text-link" href="/#evidencia">Volver al resumen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer dark-section">
    <div class="shell footer-inner">
      <img src="/brand/faldeo-lockup-horizontal-dark.svg" alt="FALDEO" width="170" height="62" />
      <p>Soluciones tecnológicas para operaciones reales.</p>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('[data-mobile-nav]').forEach((menu) => {
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => menu.removeAttribute('open'));
      });
    });
  </script>
</BaseLayout>
