---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const approach = [
  ['01', 'Entender el terreno', 'Miramos cómo ocurre el trabajo real: personas, sistemas, datos, esperas y dependencias.'],
  ['02', 'Detectar fricción', 'Buscamos cruces donde se pierde tiempo, información, trazabilidad o capacidad.'],
  ['03', 'Elegir lo correcto', 'Comparamos alternativas y seleccionamos la solución mínima que resuelve el problema.'],
  ['04', 'Construir y activar', 'Implementamos un recorrido acotado, observable y controlable antes de expandir.'],
  ['05', 'Escalar con control', 'Reutilizamos lo que demostró valor y ampliamos sólo cuando la evidencia lo justifica.']
];

const evidence = [
  {
    label: 'OPERACIÓN HOTELERA',
    title: 'Reservas y disponibilidad en un sistema hotelero en entorno de prueba',
    problem: 'Recepción, disponibilidad y reservas necesitan compartir una misma fuente operativa.',
    proof: 'Proceso de recepción, habitaciones, disponibilidad y reservas implementado y probado en un entorno de prueba.',
    status: 'ENTORNO DE PRUEBA · FLUJO IMPLEMENTADO'
  },
  {
    label: 'AGENTES + SISTEMAS',
    title: 'Agentes conectados a sistemas con permisos y controles definidos',
    problem: 'Un agente útil necesita operar sobre datos y herramientas sin recibir acceso irrestricto.',
    proof: 'Flujo técnico verificado en entorno de prueba: agente → conexión entre servicios → sistema operativo → disponibilidad y cotización.',
    status: 'ENTORNO DE PRUEBA · PRUEBA TÉCNICA'
  },
  {
    label: 'ARQUITECTURA OPERATIVA',
    title: 'Separación y trazabilidad entre organizaciones',
    problem: 'Compartir infraestructura no debe mezclar contexto, permisos ni datos entre organizaciones.',
    proof: 'Separación por organización, reglas de herramientas y auditoría verificadas como capacidad técnica interna.',
    status: 'INTERNO · CAPACIDAD TÉCNICA'
  }
];
---
<BaseLayout>
  <header class="site-header" aria-label="Cabecera principal">
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label="FALDEO, inicio">
        <img src="/brand/faldeo-lockup-horizontal-dark.svg" alt="FALDEO — Soluciones tecnológicas para operaciones reales" width="176" height="64" />
      </a>

      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#friccion">Qué resolvemos</a>
        <a href="#enfoque">Cómo trabajamos</a>
        <a href="#agentes">Agentes</a>
        <a href="#evidencia">Evidencia</a>
      </nav>

      {siteConfig.contactUrl ? (
        <a
          class="button button-small desktop-cta"
          href={siteConfig.contactUrl}
          rel={siteConfig.contactUrl.startsWith('https:') ? 'noopener noreferrer' : undefined}
        >
          {siteConfig.contactLabel}
        </a>
      ) : (
        <a class="button button-small desktop-cta" href="#inicio-trabajo">Cómo empezamos</a>
      )}

      <details class="mobile-nav" data-mobile-nav>
        <summary>Menú</summary>
        <nav aria-label="Navegación móvil">
          <a href="#friccion">Qué resolvemos</a>
          <a href="#enfoque">Cómo trabajamos</a>
          <a href="#agentes">Agentes</a>
          <a href="#evidencia">Evidencia</a>
          {siteConfig.contactUrl ? (
            <a href={siteConfig.contactUrl}>Contacto</a>
          ) : (
            <a href="#inicio-trabajo">Cómo empezamos</a>
          )}
        </nav>
      </details>
    </div>
  </header>

  <main id="contenido">
    <section class="hero dark-section" id="inicio">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">SOLUCIONES TECNOLÓGICAS PARA OPERACIONES REALES</p>
          <h1>Leemos tu operación.<br /><span>Elegimos lo que realmente resuelve.</span></h1>
          <p class="hero-lead">Software, automatización y agentes de IA alrededor de procesos concretos. Primero entendemos el terreno; después elegimos la herramienta.</p>
          <div class="hero-actions">
            {siteConfig.contactUrl && (
              <a
                class="button mobile-contact-cta"
                href={siteConfig.contactUrl}
                rel={siteConfig.contactUrl.startsWith('https:') ? 'noopener noreferrer' : undefined}
              >
                {siteConfig.contactLabel}
              </a>
            )}
            <a class="button" href="#enfoque">Ver cómo trabajamos</a>
            <a class="text-link" href="#criterio">Cómo elegimos tecnología <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="terrain-map" role="img" aria-label="Mapa operativo: entradas, fricción, decisión y capacidad conectadas por un recorrido controlado">
          <svg viewBox="0 0 720 570" aria-hidden="true">
            <g class="contours">
              <path d="M44 94 C132 22 245 18 318 72 S472 151 655 86" />
              <path d="M22 142 C117 58 244 62 318 111 S495 198 690 121" />
              <path d="M14 204 C125 126 233 126 319 166 S504 260 703 189" />
              <path d="M34 286 C132 222 232 216 329 245 S503 339 687 283" />
              <path d="M68 373 C168 310 254 304 346 332 S514 412 652 373" />
              <path d="M112 459 C194 408 282 391 367 417 S512 478 611 459" />
            </g>
            <path class="route" d="M82 448 L171 373 L218 386 L286 292 L343 307 L418 202 L502 236 L626 125" />
            <circle class="route-start" cx="82" cy="448" r="10" />
            <rect class="route-end" x="618" y="117" width="17" height="17" />
            <circle class="friction-point" cx="218" cy="386" r="10" />
            <circle class="decision-point" cx="343" cy="307" r="10" />
            <circle class="signal-point" cx="502" cy="236" r="10" />
          </svg>
          <div class="map-label map-label-a"><span>01</span><strong>TERRENO</strong><small>Personas · sistemas · datos</small></div>
          <div class="map-label map-label-b"><span>02</span><strong>FRICCIÓN</strong><small>Espera · retrabajo · pérdida</small></div>
          <div class="map-label map-label-c"><span>03</span><strong>CRITERIO</strong><small>Comparar · descartar · elegir</small></div>
          <div class="map-label map-label-d"><span>04</span><strong>CAPACIDAD</strong><small>Resultado operativo observable</small></div>
        </div>
      </div>
      <div class="shell signal-strip" aria-label="Recorrido FALDEO">
        <span>TERRENO</span><i aria-hidden="true"></i><span>FRICCIÓN</span><i aria-hidden="true"></i><span>CRITERIO</span><i aria-hidden="true"></i><span>RECORRIDO</span><i aria-hidden="true"></i><span>CAPACIDAD</span>
      </div>
    </section>

    <section class="light-section friction" id="friccion">
      <div class="shell split-heading">
        <div>
          <p class="eyebrow eyebrow-dark">DÓNDE MIRAMOS</p>
          <h2>La operación no suele romperse por falta de software.</h2>
        </div>
        <div class="section-copy">
          <p>Se rompe en los cruces: información que vive en lugares distintos, tareas que dependen de memoria, sistemas que no conversan y decisiones que llegan tarde.</p>
          <p class="strong-copy">FALDEO trabaja sobre esos cruces.</p>
        </div>
      </div>

      <div class="shell friction-line" aria-label="Ejemplos de fricción operativa">
        <div><span>01</span><strong>Planilla</strong><small>dato aislado</small></div>
        <div class="connector" aria-hidden="true"></div>
        <div><span>02</span><strong>Mensaje</strong><small>fuera del sistema</small></div>
        <div class="connector broken" aria-hidden="true"></div>
        <div class="fault"><span>!</span><strong>Fricción</strong><small>espera · error · retrabajo</small></div>
        <div class="connector" aria-hidden="true"></div>
        <div><span>03</span><strong>Persona</strong><small>dependencia manual</small></div>
        <div class="connector" aria-hidden="true"></div>
        <div><span>04</span><strong>Decisión</strong><small>llega tarde</small></div>
      </div>
    </section>

    <section class="dark-section approach" id="enfoque">
      <div class="shell">
        <div class="section-kicker">
          <p class="eyebrow">NUESTRO ENFOQUE</p>
          <p>Antes de diseñar una solución, buscamos entender el recorrido real.</p>
        </div>

        <div class="engagement-bridge" id="inicio-trabajo">
          <div>
            <p class="eyebrow">PRIMERA INTERVENCIÓN</p>
            <h3>Primero diagnosticamos. Después decidimos si vale la pena construir.</h3>
          </div>
          <div class="engagement-bridge-copy">
            <p>Empezamos por un diagnóstico acotado de un proceso operativo. Mapeamos el recorrido actual, identificamos fricciones, riesgos y oportunidades, y recomendamos qué conviene resolver.</p>
            <div class="engagement-outputs">
              <div>
                <small>PRIMER ENTREGABLE</small>
                <strong>Mapa del proceso + fricciones + recomendación</strong>
              </div>
              <div>
                <small>SI LA OPORTUNIDAD LO JUSTIFICA</small>
                <strong>Piloto pequeño y medible sobre un solo proceso</strong>
              </div>
            </div>
          </div>
        </div>

        <div class="approach-list">
          {approach.map(([number, title, body]) => (
            <article class="approach-step">
              <span class="step-number">{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
              <span class="step-mark" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="criterion light-section" id="criterio">
      <div class="shell criterion-grid">
        <div class="criterion-title">
          <p class="eyebrow eyebrow-dark">CRITERIO ANTES QUE MODA</p>
          <h2>No todo problema necesita IA.</h2>
          <p>Elegir una tecnología es una decisión de diseño operativo, no una obligación comercial.</p>
        </div>

        <div class="decision-table" role="list" aria-label="Criterios de selección tecnológica">
          <div class="decision-row" role="listitem">
            <div class="decision-input"><span>REGLA CLARA</span><small>repetitiva · estable</small></div>
            <div class="decision-arrow" aria-hidden="true">→</div>
            <div class="decision-output"><strong>Automatización</strong><small>menos complejidad</small></div>
          </div>
          <div class="decision-row" role="listitem">
            <div class="decision-input"><span>PROCESO ESPECÍFICO</span><small>estado · roles · integración</small></div>
            <div class="decision-arrow" aria-hidden="true">→</div>
            <div class="decision-output"><strong>Software / integración</strong><small>flujo explícito</small></div>
          </div>
          <div class="decision-row agent-choice" role="listitem">
            <div class="decision-input"><span>CONTEXTO DINÁMICO</span><small>herramientas · documentos · decisión</small></div>
            <div class="decision-arrow" aria-hidden="true">→</div>
            <div class="decision-output"><strong>Agente de IA</strong><small>con límites y control</small></div>
          </div>
          <div class="decision-row no-build" role="listitem">
            <div class="decision-input"><span>VALOR INSUFICIENTE</span><small>costo &gt; mejora esperada</small></div>
            <div class="decision-arrow" aria-hidden="true">→</div>
            <div class="decision-output"><strong>No construir</strong><small>también es una decisión válida</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="agents dark-section" id="agentes">
      <div class="shell agents-grid">
        <div>
          <p class="eyebrow">AGENTES DENTRO DE LA OPERACIÓN</p>
          <h2>Razonar no alcanza.<br />También hay que gobernar la acción.</h2>
          <p class="agents-copy">Un agente puede consultar sistemas, usar herramientas, procesar documentos y coordinar tareas. Cuando una acción tiene impacto real, definimos permisos, aprobación humana y trazabilidad según el riesgo.</p>
          <p class="readiness-note"><span>PREPARACIÓN PARA AGENTES</span> También preparamos datos y servicios para que agentes autorizados puedan entenderlos y utilizarlos bajo reglas y permisos explícitos.</p>
        </div>

        <div class="agent-diagram" role="img" aria-label="Persona o sistema envía contexto a un agente; el agente usa herramientas bajo reglas, aprobación humana y auditoría antes de producir una acción">
          <div class="diagram-node source-node"><small>ENTRADA</small><strong>Persona / sistema</strong></div>
          <div class="diagram-link" aria-hidden="true">→</div>
          <div class="diagram-node agent-node"><small>RAZONAMIENTO</small><strong>Agente</strong><span>contexto + herramientas</span></div>
          <div class="diagram-link" aria-hidden="true">→</div>
          <div class="diagram-node tool-node"><small>HERRAMIENTAS</small><strong>Sistemas / APIs</strong></div>
          <div class="governance-band">
            <span>REGLAS</span><span>APROBACIÓN HUMANA</span><span>AUDITORÍA</span>
          </div>
          <div class="diagram-output"><small>SALIDA</small><strong>Acción / resultado</strong><span>registrable y revisable</span></div>
        </div>
      </div>
    </section>

    <section class="evidence light-section" id="evidencia">
      <div class="shell">
        <div class="evidence-heading">
          <div>
            <p class="eyebrow eyebrow-dark">EVIDENCIA TÉCNICA</p>
            <h2>Capacidades que ya verificamos técnicamente.</h2>
          </div>
          <p>Distinguimos pruebas en entornos de prueba de capacidades internas. Estos ítems documentan factibilidad e implementación técnica; no se presentan como resultados productivos o comerciales.</p>
        </div>

        <div class="evidence-list">
          {evidence.map((item, index) => (
            <article class="evidence-item">
              <div class="evidence-index">0{index + 1}</div>
              <div class="evidence-main">
                <p class="evidence-label">{item.label}</p>
                <h3>{item.title}</h3>
                <p>{item.problem}</p>
              </div>
              <div class="evidence-proof">
                <small>QUÉ SE VERIFICÓ</small>
                <p>{item.proof}</p>
                <span class="status-tag">{item.status}</span>
              </div>
            </article>
          ))}
        </div>
        <a class="evidence-summary-link" href="/evidencia/">Abrir evidencia pública <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="contexts dark-section" aria-labelledby="contexts-title">
      <div class="shell contexts-grid">
        <div>
          <p class="eyebrow">CONTEXTOS</p>
          <h2 id="contexts-title">Dónde puede aplicar este enfoque.</h2>
          <p>Hotelería cuenta hoy con evidencia de producto en entorno de prueba. Logística, operaciones de campo, proveedores, industria y minería se mantienen como hipótesis de aplicación hasta reunir evidencia específica.</p>
        </div>
        <div class="context-list">
          <div><span>01</span><strong>Hospitality y servicios</strong><small>reservas · atención · coordinación operativa · EVIDENCIA EN ENTORNO DE PRUEBA</small></div>
          <div><span>02</span><strong>Logística y operaciones de campo</strong><small>movimientos · tareas · información distribuida · HIPÓTESIS DE APLICACIÓN</small></div>
          <div><span>03</span><strong>Proveedores, industria y minería</strong><small>documentación · mantenimiento · coordinación · compras · HIPÓTESIS DE APLICACIÓN</small></div>
        </div>
      </div>
    </section>

    {siteConfig.contactUrl ? (
      <section class="contact light-section" id="contacto">
        <div class="shell contact-inner">
          <div>
            <p class="eyebrow eyebrow-dark">PRIMERA CONVERSACIÓN</p>
            <h2>Hablemos de tu operación.</h2>
          </div>
          <div class="contact-copy">
            <p>La conversación empieza por el proceso, la fricción y el resultado que tendría sentido mejorar. No por una pila tecnológica.</p>
            <a
              class="button button-small"
              href={siteConfig.contactUrl}
              rel={siteConfig.contactUrl.startsWith('https:') ? 'noopener noreferrer' : undefined}
            >
              {siteConfig.contactLabel}
            </a>
          </div>
        </div>
      </section>
    ) : !siteConfig.isCloudflarePreview ? (
      <section class="contact light-section" id="contacto">
        <div class="shell contact-inner">
          <div>
            <p class="eyebrow eyebrow-dark">PRIMERA CONVERSACIÓN</p>
            <h2>Hablemos de tu operación.</h2>
          </div>
          <div class="contact-copy">
            <p>La conversación empieza por el proceso, la fricción y el resultado que tendría sentido mejorar. No por una pila tecnológica.</p>
            <p class="contact-pending">El canal de contacto se habilitará únicamente al aprobar la publicación.</p>
          </div>
        </div>
      </section>
    ) : null}
  </main>

  <footer class="site-footer dark-section">
    <div class="shell footer-inner">
      <img src="/brand/faldeo-lockup-horizontal-dark.svg" alt="FALDEO" width="170" height="62" />
      <p>Soluciones tecnológicas para operaciones reales.</p>
      {!siteConfig.isPublicRelease && <span>CANDIDATA PRIVADA · PUBLICACIÓN PENDIENTE</span>}
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('[data-mobile-nav]').forEach((menu) => {
      menu.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', () => {
          menu.removeAttribute('open');
        });
      });
    });
  </script>
</BaseLayout>